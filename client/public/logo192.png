<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <defs>
    <radialGradient id="shadow-bg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2d1050"/>
      <stop offset="60%" stop-color="#0a0012"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
    <radialGradient id="eye-glow-lg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="25%" stop-color="#d8b4fe"/>
      <stop offset="60%" stop-color="#9333ea"/>
      <stop offset="100%" stop-color="#581c87"/>
    </radialGradient>
    <filter id="glow-lg">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="glow-xl">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background circle -->
  <circle cx="96" cy="96" r="90" fill="url(#shadow-bg)"/>
  
  <!-- Shadow flames -->
  <path d="M96 30 Q60 60, 50 100 Q55 130, 96 145 Q137 130, 142 100 Q132 60, 96 30Z" fill="#1a0a2e" opacity="0.9"/>
  
  <!-- Outer shadow wisps -->
  <path d="M60 110 Q40 130, 30 150 Q50 140, 65 115Z" fill="#3b1570" opacity="0.5"/>
  <path d="M132 110 Q152 130, 162 150 Q142 140, 127 115Z" fill="#3b1570" opacity="0.5"/>
  <path d="M70 140 Q55 160, 45 175 Q65 165, 75 145Z" fill="#2d0a4e" opacity="0.4"/>
  <path d="M122 140 Q137 160, 147 175 Q127 165, 117 145Z" fill="#2d0a4e" opacity="0.4"/>
  <path d="M96 145 Q90 165, 85 180 Q96 175, 107 180 Q102 165, 96 145Z" fill="#1e0536" opacity="0.5"/>
  
  <!-- Crown horns -->
  <path d="M75 45 L68 15 L82 38Z" fill="#5b21b6" opacity="0.7"/>
  <path d="M86 38 L82 8 L92 32Z" fill="#6d28d9" opacity="0.8"/>
  <path d="M106 38 L110 8 L100 32Z" fill="#6d28d9" opacity="0.8"/>
  <path d="M117 45 L124 15 L110 38Z" fill="#5b21b6" opacity="0.7"/>
  
  <!-- Left eye -->
  <ellipse cx="78" cy="80" rx="10" ry="7" fill="url(#eye-glow-lg)" filter="url(#glow-lg)"/>
  <ellipse cx="78" cy="80" rx="5" ry="3.5" fill="#ffffff" opacity="0.95"/>
  
  <!-- Right eye -->
  <ellipse cx="114" cy="80" rx="10" ry="7" fill="url(#eye-glow-lg)" filter="url(#glow-lg)"/>
  <ellipse cx="114" cy="80" rx="5" ry="3.5" fill="#ffffff" opacity="0.95"/>
  
  <!-- Eye glow halos -->
  <ellipse cx="78" cy="80" rx="16" ry="12" fill="none" stroke="#9333ea" stroke-width="1" opacity="0.3" filter="url(#glow-xl)"/>
  <ellipse cx="114" cy="80" rx="16" ry="12" fill="none" stroke="#9333ea" stroke-width="1" opacity="0.3" filter="url(#glow-xl)"/>
  
  <!-- Shadow King symbol - crown mark on forehead -->
  <path d="M96 55 L92 65 L96 62 L100 65Z" fill="#a855f7" opacity="0.8" filter="url(#glow-lg)"/>
</svg>
